<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ModuleXmlReader.Presentation.ViewModels" xmlns:local="using:ModuleXmlReader.Avalonia"
        x:Class="ModuleXmlReader.Avalonia.MainWindow" x:DataType="vm:MainWindowViewModel"
        Title="Nova XML Reader" Width="1480" Height="920" MinWidth="1120" MinHeight="720" Icon="/Assets/favicon.ico">
  <Grid ColumnDefinitions="Auto,*">
    <Border Background="#101A2B" BorderBrush="#22324A" BorderThickness="0,0,1,0" Width="{Binding SidebarWidth}" ClipToBounds="True">
      <Border.Transitions><Transitions><DoubleTransition Property="Width" Duration="0:0:0.22" /></Transitions></Border.Transitions>
      <Grid RowDefinitions="Auto,*,Auto" Margin="12,20,12,18">
        <StackPanel Spacing="26">
          <Grid ColumnDefinitions="44,*" Margin="4,0">
            <Border Background="#65DEC8" CornerRadius="11" Width="36" Height="36" HorizontalAlignment="Left"><TextBlock Text="N" Foreground="#071A22" FontWeight="Bold" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Opacity="{Binding SidebarLabelOpacity}"><TextBlock Text="NOVA XML" FontWeight="Bold" FontSize="15" /><TextBlock Text="{Binding Text[Workspace]}" Classes="caption" FontSize="9" /></StackPanel>
          </Grid>
          <Button Content="☰" Command="{Binding ToggleSidebarCommand}" ToolTip.Tip="{Binding Text[MenuToggle]}" Classes="nav" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,30,0,0" Spacing="8">
          <TextBlock Text="{Binding Text[Workspace]}" Classes="caption" Margin="16,0,0,12" Opacity="{Binding SidebarLabelOpacity}" />
          <Button Name="EditorNav" Classes="nav" Classes.active="{Binding IsEditorPage}" Command="{Binding ShowEditorCommand}" ToolTip.Tip="{Binding Text[Editor]}">
            <StackPanel Orientation="Horizontal" Spacing="16"><TextBlock Text="▦" Width="20" FontSize="20" /><TextBlock Text="{Binding Text[Editor]}" VerticalAlignment="Center" Opacity="{Binding SidebarLabelOpacity}" /></StackPanel>
          </Button>
          <Button Name="ChangesNav" Classes="nav" Classes.active="{Binding IsChangesPage}" Command="{Binding ShowChangesCommand}" ToolTip.Tip="{Binding Text[Changelog]}">
            <StackPanel Orientation="Horizontal" Spacing="16"><TextBlock Text="◷" Width="20" FontSize="20" /><TextBlock Text="{Binding Text[Changelog]}" VerticalAlignment="Center" Opacity="{Binding SidebarLabelOpacity}" /></StackPanel>
          </Button>
          <Button Name="LogsNav" Classes="nav" Classes.active="{Binding IsLogsPage}" Command="{Binding ShowLogsCommand}" ToolTip.Tip="{Binding Text[Logs]}">
            <StackPanel Orientation="Horizontal" Spacing="16"><TextBlock Text="≡" Width="20" FontSize="20" /><TextBlock Text="{Binding Text[Logs]}" VerticalAlignment="Center" Opacity="{Binding SidebarLabelOpacity}" /></StackPanel>
          </Button>
          <Button Name="AboutButton" Classes="nav" Classes.active="{Binding IsAboutPage}" Command="{Binding ShowAboutPageCommand}" ToolTip.Tip="{Binding Text[About]}">
            <StackPanel Orientation="Horizontal" Spacing="16"><TextBlock Text="ⓘ" Width="20" FontSize="20" /><TextBlock Text="{Binding Text[About]}" VerticalAlignment="Center" Opacity="{Binding SidebarLabelOpacity}" /></StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="16,0,0,0" Spacing="5" Opacity="{Binding SidebarLabelOpacity}"><TextBlock Text="Nova XML Reader" FontSize="12" /><TextBlock Text="v0.5.0" Classes="caption" /></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="Auto,20,*" Margin="24,24,24,18">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="18">
        <StackPanel Spacing="6"><TextBlock Text="{Binding PageTitle}" FontSize="27" FontWeight="SemiBold" /><TextBlock Text="{Binding PageSubtitle}" Classes="muted" /></StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Content="↶" ToolTip.Tip="{Binding Text[Undo]}" Command="{Binding UndoCommand}" Classes="subtle" />
          <Button Content="↷" ToolTip.Tip="{Binding Text[Redo]}" Command="{Binding RedoCommand}" Classes="subtle" />
          <Button Name="LanguageButton" Content="{Binding LanguageButtonText}" Command="{Binding ToggleLanguageCommand}" Classes="subtle" />
          <Button Name="OpenButton" Content="{Binding Text[Open]}" Command="{Binding OpenCommand}" Classes="subtle" />
          <Button Content="{Binding Text[Export]}" Command="{Binding ExportCommand}" Classes="subtle" />
          <Button Name="SaveButton" Content="{Binding Text[Save]}" Command="{Binding SaveCommand}" Classes="primary" />
        </StackPanel>
      </Grid>
      <Grid Grid.Row="2">
        <Grid Name="EditorPage" IsVisible="{Binding IsEditorPage}" RowDefinitions="Auto,14,280,8,*">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Border IsVisible="{Binding HasChanges}" Background="#25354A" CornerRadius="6" Padding="9,4"><TextBlock Text="{Binding Text[Changed]}" Foreground="#F3C47C" IsVisible="{Binding HasChanges}" /></Border>
            <TextBlock Grid.Column="1" Text="{Binding FileStatus}" Classes="caption" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </Grid>
          <Grid Grid.Row="2" ColumnDefinitions="320,14,*">
            <Border Classes="card">
              <Grid RowDefinitions="Auto,12,*"><TextBlock Text="{Binding Text[Parameters]}" FontWeight="SemiBold" />
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl Name="ParametersPanel" ItemsSource="{Binding Parameters}">
                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ParameterViewModel"><Grid ColumnDefinitions="*,*" Margin="0,0,0,9" ColumnSpacing="8"><TextBlock Text="{Binding Label}" FontSize="11" Foreground="#94A7C2" TextWrapping="Wrap" /><TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap" /></Grid></DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </Grid>
            </Border>
            <Border Grid.Column="2" Classes="card">
              <Grid RowDefinitions="Auto,10,*,Auto,Auto" RowSpacing="4">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Text[DataTables]}" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Name="RotateButton" Command="{Binding RotateCommand}" Classes="subtle" Grid.Column="1" ToolTip.Tip="{Binding Text[RotateTip]}"><TextBlock Name="RotationLabelText" Text="{Binding RotationLabel}" /></Button></Grid>
                <TabControl Name="DataTabs" Grid.Row="2">
                  <TabItem Header="{Binding Text[Coordinates]}"><Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="55,80,80,*,Auto" Margin="4"><TextBlock Text="#" /><TextBlock Grid.Column="1" Text="X" /><TextBlock Grid.Column="2" Text="Y" /><TextBlock Grid.Column="3" Text="{Binding Text[State]}" /></Grid>
                    <ListBox Name="CoordinateList" Grid.Row="1" ItemsSource="{Binding Coordinates}" SelectedItem="{Binding SelectedCoordinate, Mode=TwoWay}"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:CoordinateRowViewModel"><Grid ColumnDefinitions="55,80,80,*,Auto" ColumnSpacing="4"><TextBlock Text="{Binding Number}" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding X, Mode=TwoWay}" Padding="4" /><TextBox Grid.Column="2" Text="{Binding Y, Mode=TwoWay}" Padding="4" /><TextBlock Grid.Column="3" Text="{Binding State}" VerticalAlignment="Center" TextWrapping="Wrap" /><Button Grid.Column="4" Content="{Binding Text[Apply]}" Command="{Binding ApplyCommand}" Padding="8,4" /></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
                  </Grid></TabItem>
                  <TabItem Name="PointSourceTab" Header="{Binding Text[PointsTab]}"><TextBox Name="PointTableText" SelectionStart="{Binding Navigation.SelectionStart, Mode=OneWay}" SelectionEnd="{Binding Navigation.SelectionEnd, Mode=OneWay}" Text="{Binding PointTableData, Mode=TwoWay}" IsReadOnly="{Binding IsEditorReadOnly}" AcceptsReturn="True" TextWrapping="Wrap" Classes="code" /></TabItem>
                  <TabItem Name="NewScanTabItem" Header="{Binding Text[NewScanTab]}"><Grid ColumnDefinitions="2*,*" ColumnSpacing="8"><ListBox ItemsSource="{Binding NewCodes}"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:ScanCodeRowViewModel"><Border Background="{Binding Background}" Padding="4"><Grid ColumnDefinitions="36,55,*,Auto,Auto,Auto" ColumnSpacing="4"><TextBlock Text="{Binding Index}" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" Padding="3" /><TextBlock Grid.Column="2" Text="{Binding State}" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" /><Button Grid.Column="3" Content="↑" Command="{Binding UpCommand}" IsEnabled="{Binding IsActive}" Padding="5" /><Button Grid.Column="4" Content="↓" Command="{Binding DownCommand}" IsEnabled="{Binding IsActive}" Padding="5" /><Button Grid.Column="5" Content="{Binding Text[Apply]}" Command="{Binding ApplyCommand}" Padding="5" /></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBox Grid.Column="1" Name="NewScanText" Text="{Binding NewScanABCDCode, Mode=TwoWay}" IsReadOnly="{Binding IsEditorReadOnly}" AcceptsReturn="True" TextWrapping="Wrap" Classes="code" /></Grid></TabItem>
                  <TabItem Header="{Binding Text[Batch]}"><Grid RowDefinitions="Auto,*" RowSpacing="8"><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="{Binding Text[BatchValidate]}" Command="{Binding BatchValidateCommand}" /><Button Content="{Binding Text[BatchVariants]}" Command="{Binding BatchVariantsCommand}" /><Button Content="{Binding Text[Cancel]}" Command="{Binding CancelBatchCommand}" /></StackPanel><TextBox Grid.Row="1" Text="{Binding BatchReport}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Classes="code" /></Grid></TabItem>
                  <TabItem Header="{Binding Text[Diagnostics]}"><ScrollViewer><ItemsControl ItemsSource="{Binding Diagnostics}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:DiagnosticViewModel"><Button Command="{Binding GoCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,2" Padding="6"><Grid ColumnDefinitions="90,*,120" ColumnSpacing="8"><TextBlock Text="{Binding Severity}" Foreground="#F6B768" /><TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" /><TextBlock Grid.Column="2" Text="{Binding Field}" Classes="caption" TextWrapping="Wrap" /></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></TabItem>
                  <TabItem Header="{Binding Text[Compare]}"><Grid RowDefinitions="Auto,*" RowSpacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="10"><Button Content="{Binding Text[CompareFile]}" Command="{Binding CompareCommand}" /><TextBlock Text="{Binding ComparisonPath}" Classes="caption" VerticalAlignment="Center" /></StackPanel>
                    <ScrollViewer Grid.Row="1"><ItemsControl ItemsSource="{Binding Differences}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:DifferenceViewModel"><Grid ColumnDefinitions="100,140,*,*" ColumnSpacing="8" Margin="0,3"><TextBlock Text="{Binding Category}" TextWrapping="Wrap" /><TextBlock Grid.Column="1" Text="{Binding Name}" TextWrapping="Wrap" /><TextBlock Grid.Column="2" Text="{Binding Before}" Foreground="#FF8795" TextWrapping="Wrap" /><TextBlock Grid.Column="3" Text="{Binding After}" Foreground="#65DEC8" TextWrapping="Wrap" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
                  </Grid></TabItem>
                  <TabItem Header="{Binding Text[ActionHistory]}"><TextBox Text="{Binding ActionHistory}" IsReadOnly="True" AcceptsReturn="True" Classes="code" /></TabItem>
                  <TabItem Name="LegacyScanTabItem" Header="{Binding Text[ScanTab]}"><Grid ColumnDefinitions="2*,*" ColumnSpacing="8"><ListBox ItemsSource="{Binding LegacyCodes}"><ListBox.ItemTemplate><DataTemplate x:DataType="vm:ScanCodeRowViewModel"><Border Background="{Binding Background}" Padding="4"><Grid ColumnDefinitions="36,55,*,Auto,Auto,Auto" ColumnSpacing="4"><TextBlock Text="{Binding Index}" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding Value, Mode=TwoWay}" Padding="3" /><TextBlock Grid.Column="2" Text="{Binding State}" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" /><Button Grid.Column="3" Content="↑" Command="{Binding UpCommand}" IsEnabled="{Binding IsActive}" Padding="5" /><Button Grid.Column="4" Content="↓" Command="{Binding DownCommand}" IsEnabled="{Binding IsActive}" Padding="5" /><Button Grid.Column="5" Content="{Binding Text[Apply]}" Command="{Binding ApplyCommand}" Padding="5" /></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBox Grid.Column="1" Name="ScanText" Text="{Binding ScanABCDCode, Mode=TwoWay}" IsReadOnly="{Binding IsEditorReadOnly}" AcceptsReturn="True" TextWrapping="Wrap" Classes="code" /></Grid></TabItem>
                </TabControl>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10"><TextBlock Text="{Binding Text[Missing]}" Classes="caption" /><TextBlock Name="MissingText" Text="{Binding MissingPixels}" Foreground="#C8A0F5" FontSize="12" IsVisible="{Binding Navigation.HasNoMissing}" />
                  <Button Content="◀" ToolTip.Tip="{Binding Text[PreviousMissing]}" Command="{Binding Navigation.PreviousMissingCommand}" Padding="6,2" />
                  <Button Content="▶" ToolTip.Tip="{Binding Text[NextMissing]}" Command="{Binding Navigation.NextMissingCommand}" Padding="6,2" />
                  <ScrollViewer MaxWidth="440" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Navigation.Missing}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:MissingPointViewModel"><Button Content="{Binding Number}" Command="{Binding SelectCommand}" Foreground="#C8A0F5" Padding="5,2" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></StackPanel>
                <TextBlock Grid.Row="4" Text="{Binding ValidationError}" Foreground="#FF8795" TextWrapping="Wrap" FontSize="12" />
              </Grid>
            </Border>
          </Grid>
          <GridSplitter Grid.Row="3" Height="8" ResizeDirection="Rows" HorizontalAlignment="Stretch" Background="Transparent" />
          <Border Grid.Row="4" Classes="card" Padding="12"><local:ModuleViewport Name="ModuleCanvas" Navigation="{Binding Navigation}" Simulation="{Binding Simulation}" Data="{Binding Preview}" Text="{Binding Text}" MinHeight="130" /></Border>
        </Grid>
        <Grid Name="ChangesPage" IsVisible="{Binding IsChangesPage}" RowDefinitions="Auto,18,*">
          <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Text[ReloadHint]}" Classes="muted" /><Button Grid.Column="1" Content="{Binding Text[Refresh]}" Command="{Binding RefreshChangesCommand}" Classes="subtle" /></Grid>
          <TextBlock Grid.Row="2" Text="{Binding Text[NoChanges]}" IsVisible="{Binding !HasChangelog}" Classes="muted" />
          <ScrollViewer Grid.Row="2"><ItemsControl ItemsSource="{Binding ChangeEntries}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ChangelogEntryViewModel">
            <Border Classes="card" Margin="0,0,0,14"><StackPanel Spacing="12"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14"><Border Background="#203A4B" CornerRadius="7" Padding="10,5"><TextBlock Text="{Binding Version}" Foreground="#65DEC8" FontWeight="SemiBold" /></Border><TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="{Binding Date}" Classes="caption" VerticalAlignment="Center" /></Grid><TextBlock Text="{Binding Description}" TextWrapping="Wrap" LineHeight="23" Foreground="#B9C9DF" /></StackPanel></Border>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        </Grid>
        <Grid Name="LogsPage" IsVisible="{Binding IsLogsPage}" RowDefinitions="Auto,12,Auto,12,*">
          <Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8"><Button Classes.active="{Binding IsActivityLog}" Content="{Binding Text[Activity]}" Command="{Binding ActivityLogsCommand}" Classes="subtle" /><Button Classes.active="{Binding IsErrorLog}" Content="{Binding Text[Errors]}" Command="{Binding ErrorLogsCommand}" Classes="subtle" /><Button Classes.active="{Binding IsDiagnosticLog}" Content="{Binding Text[Diagnostics]}" Command="{Binding DiagnosticLogsCommand}" Classes="subtle" /></StackPanel><Button Grid.Column="1" Content="{Binding Text[Refresh]}" Command="{Binding RefreshLogsCommand}" Classes="primary" /></Grid>
          <StackPanel Grid.Row="2" Spacing="5"><TextBlock Text="{Binding Text[LogHint]}" Classes="muted" /><TextBlock Text="{Binding LogDirectory}" Classes="caption" TextWrapping="Wrap" /></StackPanel>
          <Border Grid.Row="4" Classes="card" Padding="8"><TextBox Text="{Binding LogText}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" Classes="code" /></Border>
        </Grid>
        <Border Name="AboutPage" IsVisible="{Binding IsAboutPage}" Classes="card" VerticalAlignment="Top" MaxWidth="700" HorizontalAlignment="Left" Padding="30">
          <StackPanel Spacing="18"><TextBlock Text="Nova XML Reader" FontSize="30" FontWeight="SemiBold" Foreground="#65DEC8" /><TextBlock Text="{Binding Text[AboutDescription]}" TextWrapping="Wrap" FontSize="16" /><TextBlock Text="{Binding AboutText}" Foreground="#A9B9CE" LineHeight="25" /><Button Content="{Binding Text[About]}" Command="{Binding AboutCommand}" Classes="subtle" HorizontalAlignment="Left" /></StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
