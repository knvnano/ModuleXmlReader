<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.5.0</Version>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets/favicon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <ProjectReference Include="../ModuleXmlReader.Infrastructure/ModuleXmlReader.Infrastructure.csproj" />
    <ProjectReference Include="../ModuleXmlReader.Presentation/ModuleXmlReader.Presentation.csproj" />
    <Content Include="changelog.json" CopyToOutputDirectory="PreserveNewest" />
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>
</Project>
