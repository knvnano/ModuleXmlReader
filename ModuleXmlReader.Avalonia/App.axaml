<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ModuleXmlReader.Avalonia.App" RequestedThemeVariant="Dark">
  <Application.Resources>
    <SolidColorBrush x:Key="AppBackground">#0B1220</SolidColorBrush>
    <SolidColorBrush x:Key="PanelBackground">#111D30</SolidColorBrush>
    <SolidColorBrush x:Key="PanelBorder">#24334A</SolidColorBrush>
    <SolidColorBrush x:Key="MutedForeground">#94A7C2</SolidColorBrush>
    <SolidColorBrush x:Key="AccentForeground">#65DEC8</SolidColorBrush>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window"><Setter Property="Background" Value="{StaticResource AppBackground}" /><Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="Foreground" Value="#E8EEF8" /></Style>
    <Style Selector="Button"><Setter Property="CornerRadius" Value="9" /><Setter Property="Padding" Value="14,9" /><Setter Property="MinHeight" Value="36" /></Style>
    <Style Selector="Button.primary"><Setter Property="Background" Value="#65DEC8" /><Setter Property="Foreground" Value="#071A22" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style Selector="Button.subtle"><Setter Property="Background" Value="#19283E" /><Setter Property="BorderBrush" Value="#2A3C55" /><Setter Property="BorderThickness" Value="1" /></Style>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="16,13" /><Setter Property="Foreground" Value="#A9B9CE" />
      <Setter Property="Transitions"><Transitions><BrushTransition Property="Background" Duration="0:0:0.18" /></Transitions></Setter>
    </Style>
    <Style Selector="Button.nav.active"><Setter Property="Background" Value="#203A4B" /><Setter Property="Foreground" Value="#7CE9D1" /></Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter"><Setter Property="Background" Value="#203A4B" /></Style>
    <Style Selector="Button.subtle.active /template/ ContentPresenter"><Setter Property="Background" Value="#203A4B" /><Setter Property="BorderBrush" Value="#65DEC8" /></Style>
    <Style Selector="TabItem"><Setter Property="FontSize" Value="13" /></Style>
    <Style Selector="Button.nav TextBlock"><Setter Property="Transitions"><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.16" /></Transitions></Setter></Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#22324A" /></Style>
    <Style Selector="Border.card"><Setter Property="Background" Value="{StaticResource PanelBackground}" /><Setter Property="BorderBrush" Value="{StaticResource PanelBorder}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="14" /><Setter Property="Padding" Value="18" /></Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{StaticResource MutedForeground}" /></Style>
    <Style Selector="TextBlock.caption"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{StaticResource MutedForeground}" /></Style>
    <Style Selector="TextBox.code"><Setter Property="FontFamily" Value="Cascadia Mono,Consolas" /><Setter Property="FontSize" Value="12" /><Setter Property="Background" Value="#0B1424" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="12" /></Style>
  </Application.Styles>
</Application>
